    "comfy": "bash './Start Medartis Asset Generator.command' --ai-only",
    "setup:conditioning": "bash ai/tools/setup_conditioning.sh",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node --check vite-plugin-genai.js && node --check vite-plugin-canto.js && node ai/tools/check_hook_deps.mjs src/MedartisBrandGenerator.jsx",
    "link:models": "bash ai/tools/link_webui_models.sh"
  },
