{
  "name": "medartis-brand-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "bash './Start Medartis Asset Generator.command'",
    "dev": "echo '\u26a0  app only \u2014 no ComfyUI. Use: npm start (boots both)' && vite",
