{
  "_comment": "Z-Image Turbo (Tongyi S3-DiT, 6B) text-to-image — the 2026 Mac sweet spot: Flux-level photorealism in 8 steps at CFG 1, ~3x faster than Flux on Apple Silicon. Node ids follow the house convention: 6 positive prompt, 5 latent, 3 sampler, 8 VAEDecode, 90/91/92 upscale tail, 9 SaveImage — so compilePrompt/configureUpscale patch it exactly like the other engines. CFG 1 means the negative is zeroed (ConditioningZeroOut) — like Flux, realism must be asserted POSITIVELY; the run report says so.",
  "_licence": "Z-Image-Turbo weights are Apache-2.0 (Tongyi-MAI) — commercially usable, unlike FLUX.1 [dev].",
  "28": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "default" }
  },
  "30": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "lumina2", "device": "default" }
  },
  "29": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "ae.safetensors" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["30", 0], "text": "medartishouse editorial product photograph" }
  },
  "33": {
    "class_type": "ConditioningZeroOut",
    "inputs": { "conditioning": ["6", 0] }
  },
  "11": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": { "model": ["28", 0], "shift": 3 }
  },
  "5": {
    "class_type": "EmptySD3LatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["11", 0],
      "positive": ["6", 0],
      "negative": ["33", 0],
      "latent_image": ["5", 0],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["29", 0] }
  },
  "90": {
    "class_type": "UpscaleModelLoader",
    "inputs": { "model_name": "RealESRGAN_x4plus.pth" }
  },
  "91": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": { "upscale_model": ["90", 0], "image": ["8", 0] }
  },
  "92": {
    "class_type": "ImageScale",
    "inputs": { "image": ["91", 0], "upscale_method": "lanczos", "width": 2048, "height": 2048, "crop": "disabled" }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "images": ["92", 0], "filename_prefix": "medartis_zimage" }
  }
}
