{
  "_comment": "SDXL base 1.0 + the IBRA house LoRA. THE COMMERCIAL PATH: OpenRAIL++ base, LoRA trained on your own photographs — the only route whose output can ship in published IBRA collateral. The plugin patches: 6.text, 7.text (negative), 5.width/height, 3.seed/steps/cfg, 10.lora_name + strengths, and swaps the sampler to LCM when the lcm_lora is stacked.",
  "_lcm": "With lcm_lora_sdxl stacked (node 11), drop to 6 steps / CFG 1.5 with the lcm sampler — seconds per draft, on the SAME architecture as the house LoRA. Unlike SDXL Turbo, these drafts DO carry the IBRA look.",

  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" }
  },
  "14": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "sdxl_vae.safetensors" }
  },
  "10": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "ibra_house_sdxl.safetensors",
      "strength_model": 0.85,
      "strength_clip": 0.85,
      "model": ["4", 0],
      "clip": ["4", 1]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "PROMPT", "clip": ["10", 1] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "NEGATIVE", "clip": ["10", 1] }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 28,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["10", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["14", 0] }
  },
  "90": {
    "class_type": "UpscaleModelLoader",
    "inputs": { "model_name": "RealESRGAN_x4plus.pth" }
  },
  "91": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": { "upscale_model": ["90", 0], "image": ["8", 0] }
  },
  "92": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["91", 0],
      "upscale_method": "lanczos",
      "width": 1080,
      "height": 1080,
      "crop": "disabled"
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "medartis/sdxl", "images": ["92", 0] }
  }
}
