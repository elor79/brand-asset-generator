# Canto DAM integration — copy to .env.local and fill in
# The Vite plugin (vite-plugin-canto.js) reads these and exposes /api/canto/*

# Your Canto subdomain (no scheme, no trailing slash)
# e.g. medartis.canto.global  or  medartis.canto.de
CANTO_DOMAIN=

# OPTION A — easiest: paste a pre-generated access token from
# Canto Settings → API Tokens → Client Credentials Mode
CANTO_ACCESS_TOKEN=

# OPTION B — full OAuth: plugin will fetch + cache tokens for you
# CANTO_APP_ID=
# CANTO_APP_SECRET=
